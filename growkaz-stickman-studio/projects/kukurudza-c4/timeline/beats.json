[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 5.52,
  "text": "Кажуть, тихої липневої ночі посеред кукурудзяного поля можна почути,",
  "end": 5.57
 },
 {
  "i": 1,
  "start": 5.57,
  "speechStart": 5.72,
  "speechEnd": 6.8,
  "text": "як воно росте.",
  "end": 7.31
 },
 {
  "i": 2,
  "start": 7.31,
  "speechStart": 7.46,
  "speechEnd": 8.92,
  "text": "Це, звісно, приказка.",
  "end": 9.35
 },
 {
  "i": 3,
  "start": 9.35,
  "speechStart": 9.5,
  "speechEnd": 14.78,
  "text": "Але в розпал літа кукурудза справді додає кілька сантиметрів за добу.",
  "end": 14.63
 },
 {
  "i": 4,
  "start": 14.63,
  "speechStart": 14.78,
  "speechEnd": 18.42,
  "text": "А пшениця на сусідньому полі так не вміє. Чому?",
  "end": 19.23
 },
 {
  "i": 5,
  "start": 19.23,
  "speechStart": 19.38,
  "speechEnd": 21.54,
  "text": "Усі рослини харчуються однаково:",
  "end": 21.83
 },
 {
  "i": 6,
  "start": 21.83,
  "speechStart": 21.98,
  "speechEnd": 27.16,
  "text": "беруть із повітря вуглекислий газ, а сонячне світло перетворюють на цукор.",
  "end": 27.01
 },
 {
  "i": 7,
  "start": 27.01,
  "speechStart": 27.16,
  "speechEnd": 30.09,
  "text": "Але кукурудза робить це по-іншому.",
  "end": 29.94
 },
 {
  "i": 8,
  "start": 29.94,
  "speechStart": 30.09,
  "speechEnd": 36.32,
  "text": "У неї є вбудований «турбонаддув», якого немає в більшості рослин на планеті.",
  "end": 36.81
 },
 {
  "i": 9,
  "start": 36.81,
  "speechStart": 36.96,
  "speechEnd": 41.9,
  "text": "Щоб зрозуміти, як він працює, треба зазирнути всередину листка.",
  "end": 42.59
 },
 {
  "i": 10,
  "start": 42.59,
  "speechStart": 42.74,
  "speechEnd": 46.86,
  "text": "Головну роботу в листку виконує фермент із назвою рубіско.",
  "end": 47.43
 },
 {
  "i": 11,
  "start": 47.43,
  "speechStart": 47.58,
  "speechEnd": 52.28,
  "text": "Він хапає молекули вуглекислого газу, з яких потім будується цукор.",
  "end": 52.67
 },
 {
  "i": 12,
  "start": 52.67,
  "speechStart": 52.82,
  "speechEnd": 54.18,
  "text": "Але в нього є вада:",
  "end": 54.71
 },
 {
  "i": 13,
  "start": 54.71,
  "speechStart": 54.86,
  "speechEnd": 56.38,
  "text": "рубіско плутає.",
  "end": 56.23
 },
 {
  "i": 14,
  "start": 56.23,
  "speechStart": 56.38,
  "speechEnd": 61.32,
  "text": "Час від часу замість вуглекислого газу він хапає кисень.",
  "end": 61.65
 },
 {
  "i": 15,
  "start": 61.65,
  "speechStart": 61.8,
  "speechEnd": 65.96,
  "text": "Тоді рослина витрачає енергію, щоб виправити помилку.",
  "end": 65.81
 },
 {
  "i": 16,
  "start": 65.81,
  "speechStart": 65.96,
  "speechEnd": 68.66,
  "text": "Це називають фотодиханням.",
  "end": 68.95
 },
 {
  "i": 17,
  "start": 68.95,
  "speechStart": 69.1,
  "speechEnd": 71.82,
  "text": "А в спеку рубіско помиляється ще частіше.",
  "end": 72.23
 },
 {
  "i": 18,
  "start": 72.23,
  "speechStart": 72.38,
  "speechEnd": 73.98,
  "text": "Кукурудза знайшла вихід.",
  "end": 74.41
 },
 {
  "i": 19,
  "start": 74.41,
  "speechStart": 74.56,
  "speechEnd": 79.96,
  "text": "У зовнішніх клітинах її листка працює інший фермент, який кисень не плутає.",
  "end": 79.81
 },
 {
  "i": 20,
  "start": 79.81,
  "speechStart": 79.96,
  "speechEnd": 83.66,
  "text": "Він ловить вуглекислий газ і пакує його в",
  "end": 83.51
 },
 {
  "i": 21,
  "start": 83.51,
  "speechStart": 83.66,
  "speechEnd": 88.46,
  "text": "спеціальну молекулу з чотирма атомами вуглецю. Звідси назва:",
  "end": 88.31
 },
 {
  "i": 22,
  "start": 88.31,
  "speechStart": 88.46,
  "speechEnd": 90.58,
  "text": "це-чотири рослини.",
  "end": 91.11
 },
 {
  "i": 23,
  "start": 91.11,
  "speechStart": 91.26,
  "speechEnd": 94.08,
  "text": "Ці «пакунки» передаються вглиб,",
  "end": 93.93
 },
 {
  "i": 24,
  "start": 93.93,
  "speechStart": 94.08,
  "speechEnd": 97.96,
  "text": "до клітин навколо жилки, і там газ вивільняється.",
  "end": 98.51
 },
 {
  "i": 25,
  "start": 98.51,
  "speechStart": 98.66,
  "speechEnd": 103.74,
  "text": "Виходить, що рубіско сидить у кімнаті, переповненій вуглекислим газом.",
  "end": 103.59
 },
 {
  "i": 26,
  "start": 103.59,
  "speechStart": 103.74,
  "speechEnd": 109.94,
  "text": "За оцінками науковців, його там у кілька разів більше, ніж у звичайному повітрі.",
  "end": 110.31
 },
 {
  "i": 27,
  "start": 110.31,
  "speechStart": 110.46,
  "speechEnd": 113.46,
  "text": "Помилятися майже ні на чому.",
  "end": 113.31
 },
 {
  "i": 28,
  "start": 113.31,
  "speechStart": 113.46,
  "speechEnd": 115.72,
  "text": "Цей насос дає ще одну перевагу.",
  "end": 116.01
 },
 {
  "i": 29,
  "start": 116.01,
  "speechStart": 116.16,
  "speechEnd": 121.16,
  "text": "Щоб дістати газ, рослина відкриває на листку крихітні пори — продихи.",
  "end": 121.47
 },
 {
  "i": 30,
  "start": 121.47,
  "speechStart": 121.62,
  "speechEnd": 123.86,
  "text": "А через них випаровується вода.",
  "end": 124.31
 },
 {
  "i": 31,
  "start": 124.31,
  "speechStart": 124.46,
  "speechEnd": 127.42,
  "text": "Кукурудзі не треба тримати їх широко відкритими,",
  "end": 127.27
 },
 {
  "i": 32,
  "start": 127.27,
  "speechStart": 127.42,
  "speechEnd": 133.1,
  "text": "тож на кожен грам урожаю вона витрачає приблизно вдвічі менше води,",
  "end": 132.95
 },
 {
  "i": 33,
  "start": 132.95,
  "speechStart": 133.1,
  "speechEnd": 134.22,
  "text": "ніж пшениця.",
  "end": 134.61
 },
 {
  "i": 34,
  "start": 134.61,
  "speechStart": 134.76,
  "speechEnd": 136.28,
  "text": "Але в цього є ціна.",
  "end": 136.73
 },
 {
  "i": 35,
  "start": 136.73,
  "speechStart": 136.88,
  "speechEnd": 138.82,
  "text": "Насос споживає енергію.",
  "end": 139.25
 },
 {
  "i": 36,
  "start": 139.25,
  "speechStart": 139.4,
  "speechEnd": 142.66,
  "text": "У тепло цю витрату з лишком окупає швидкий ріст.",
  "end": 142.97
 },
 {
  "i": 37,
  "start": 142.97,
  "speechStart": 143.12,
  "speechEnd": 145.18,
  "text": "А в холод перевага зникає.",
  "end": 145.59
 },
 {
  "i": 38,
  "start": 145.59,
  "speechStart": 145.74,
  "speechEnd": 149.22,
  "text": "Кукурудза мерзне, сидить на місці й чекає.",
  "end": 149.77
 },
 {
  "i": 39,
  "start": 149.77,
  "speechStart": 149.92,
  "speechEnd": 152.54,
  "text": "Тому досвідчені фермери не поспішають:",
  "end": 152.81
 },
 {
  "i": 40,
  "start": 152.81,
  "speechStart": 152.96,
  "speechEnd": 156.64,
  "text": "сіють тоді, коли ґрунт прогріється приблизно до десяти градусів.",
  "end": 158.14
 }
]