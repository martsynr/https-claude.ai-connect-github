[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 2.84,
  "text": "Тобою керують через маленьке «так».",
  "end": 3.91
 },
 {
  "i": 1,
  "start": 3.91,
  "speechStart": 4.06,
  "speechEnd": 9.66,
  "text": "І ти навіть не помічаєш. 1966 рік.",
  "end": 10.31
 },
 {
  "i": 2,
  "start": 10.31,
  "speechStart": 10.46,
  "speechEnd": 14.1,
  "text": "Психологи Фрідман і Фрейзер просять людей поставити",
  "end": 13.95
 },
 {
  "i": 3,
  "start": 13.95,
  "speechStart": 14.1,
  "speechEnd": 17.38,
  "text": "на газоні величезний щит «Їдь обережно».",
  "end": 17.87
 },
 {
  "i": 4,
  "start": 17.87,
  "speechStart": 18.02,
  "speechEnd": 20.46,
  "text": "Погоджуються менше ніж двоє з десяти.",
  "end": 20.93
 },
 {
  "i": 5,
  "start": 20.93,
  "speechStart": 21.08,
  "speechEnd": 24.44,
  "text": "Але іншим двома тижнями раніше дали",
  "end": 24.29
 },
 {
  "i": 6,
  "start": 24.29,
  "speechStart": 24.44,
  "speechEnd": 28.06,
  "text": "крихітну табличку для вікна «Будь обережним водієм».",
  "end": 27.91
 },
 {
  "i": 7,
  "start": 27.91,
  "speechStart": 28.06,
  "speechEnd": 33.75,
  "text": "І з них на великий щит погодилися майже троє з чотирьох.",
  "end": 33.6
 },
 {
  "i": 8,
  "start": 33.6,
  "speechStart": 33.75,
  "speechEnd": 37.76,
  "text": "Маленьке «так» змінює те, ким ти себе вважаєш.",
  "end": 38.09
 },
 {
  "i": 9,
  "start": 38.09,
  "speechStart": 38.24,
  "speechEnd": 41.58,
  "text": "А відмовити потім означає піти проти себе.",
  "end": 42.29
 },
 {
  "i": 10,
  "start": 42.29,
  "speechStart": 42.44,
  "speechEnd": 44.56,
  "text": "Це прийом «нога у дверях»:",
  "end": 45.03
 },
 {
  "i": 11,
  "start": 45.03,
  "speechStart": 45.18,
  "speechEnd": 49.42,
  "text": "пробний період «просто вкажи картку», «можна тебе на хвилинку?».",
  "end": 49.27
 },
 {
  "i": 12,
  "start": 49.27,
  "speechStart": 49.42,
  "speechEnd": 52.68,
  "text": "Тож перед великим «так» спитай себе:",
  "end": 53.25
 },
 {
  "i": 13,
  "start": 53.25,
  "speechStart": 53.4,
  "speechEnd": 59.88,
  "text": "«Якби мене попросили про це вперше — я б погодився?» Якщо ні, кажи «ні».",
  "end": 60.31
 },
 {
  "i": 14,
  "start": 60.31,
  "speechStart": 60.46,
  "speechEnd": 64.3,
  "text": "Підписуйся, щоб бачити маніпуляції раніше, ніж вони спрацюють.",
  "end": 65.8
 }
]