[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 5.14,
  "text": "Торік Іван Петрович посіяв гібрид кукурудзи і цього року знову його замовив.",
  "end": 5.31
 },
 {
  "i": 1,
  "start": 5.31,
  "speechStart": 5.46,
  "speechEnd": 8.34,
  "text": "Але цього разу в мішку зовсім інше зерно.",
  "end": 8.47
 },
 {
  "i": 2,
  "start": 8.47,
  "speechStart": 8.62,
  "speechEnd": 12.48,
  "text": "Торік було пласке, а тепер — кругле. Фермера надурили?",
  "end": 12.69
 },
 {
  "i": 3,
  "start": 12.69,
  "speechStart": 12.84,
  "speechEnd": 14.42,
  "text": "Не поспішайте з висновками!",
  "end": 14.77
 },
 {
  "i": 4,
  "start": 14.77,
  "speechStart": 14.92,
  "speechEnd": 19.26,
  "text": "Насіння одного й того самого гібрида буває і круглим, і пласким.",
  "end": 19.45
 },
 {
  "i": 5,
  "start": 19.45,
  "speechStart": 19.6,
  "speechEnd": 22.88,
  "text": "Це залежить від того, з якої частини качана взяте зерно.",
  "end": 22.73
 },
 {
  "i": 6,
  "start": 22.73,
  "speechStart": 22.88,
  "speechEnd": 28.46,
  "text": "На верхівці й біля основи зерно кругліше, а посередині, де йому тісно, — пласке.",
  "end": 28.31
 },
 {
  "i": 7,
  "start": 28.31,
  "speechStart": 28.46,
  "speechEnd": 33.14,
  "text": "На форму зерна впливає і погода, а вона майже щороку інша.",
  "end": 33.43
 },
 {
  "i": 8,
  "start": 33.43,
  "speechStart": 33.58,
  "speechEnd": 38.88,
  "text": "На заводі все насіння калібрують — тобто сортують на фракції за формою та розміром.",
  "end": 39.03
 },
 {
  "i": 9,
  "start": 39.03,
  "speechStart": 39.18,
  "speechEnd": 41.88,
  "text": "Але це все насіння одного гібрида —",
  "end": 41.73
 },
 {
  "i": 10,
  "start": 41.73,
  "speechStart": 41.88,
  "speechEnd": 45.86,
  "text": "з тим самим набором генів і тими самими посівними якостями.",
  "end": 46.05
 },
 {
  "i": 11,
  "start": 46.05,
  "speechStart": 46.2,
  "speechEnd": 47.52,
  "text": "Лише пам'ятайте:",
  "end": 47.37
 },
 {
  "i": 12,
  "start": 47.37,
  "speechStart": 47.52,
  "speechEnd": 50.64,
  "text": "нова фракція — це нове налаштування сівалки.",
  "end": 50.83
 },
 {
  "i": 13,
  "start": 50.83,
  "speechStart": 50.98,
  "speechEnd": 53.24,
  "text": "Підберіть висівний диск під розмір зерна.",
  "end": 53.43
 },
 {
  "i": 14,
  "start": 53.43,
  "speechStart": 53.58,
  "speechEnd": 56.04,
  "text": "Відрегулюйте вакуум і скидач двійників.",
  "end": 55.89
 },
 {
  "i": 15,
  "start": 55.89,
  "speechStart": 56.04,
  "speechEnd": 58.66,
  "text": "І обов'язково зробіть пробний висів.",
  "end": 58.73
 },
 {
  "i": 16,
  "start": 58.73,
  "speechStart": 58.88,
  "speechEnd": 62.84,
  "text": "А вам яке насіння більше подобається — кругленьке чи пласке?",
  "end": 64.34
 }
]